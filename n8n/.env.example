# Copy to n8n/.env (gitignored), or let `pwsh -File n8n/setup.ps1` copy it. Values that differ per machine.
# Workflows read them through $env, so a name here is part of the workflows: rename it in both places.

# n8n encrypts the stored credentials with this key. setup.ps1 fills it in once. Never change it on a kept volume:
# n8n refuses to start with a key that does not match the one it was first started with.
N8N_ENCRYPTION_KEY=change-me

# The backend's address as the container sees it. host.docker.internal is the Windows host.
WEBCITY_BACKEND_URL=https://host.docker.internal:7102
# The frontend's address, for links in emails.
WEBCITY_FRONTEND_URL=http://localhost:4200
# The product's name, as emails and alerts write it.
WEBCITY_PRODUCT_NAME=Ezzo

# Telegram chats the bot writes to. A group's id starts with a minus sign.
TELEGRAM_DEVELOPERS_CHAT_ID=change-me
TELEGRAM_ADMINISTRATORS_CHAT_ID=change-me

# Where moderation emails go, and who sends the automation's emails.
WEBCITY_ADMINISTRATOR_EMAIL=admin@example.com
WEBCITY_SENDER_EMAIL=noreply@example.com
WEBCITY_SENDER_NAME=Ezzo
