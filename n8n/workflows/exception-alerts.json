    {
      "parameters": {
        "jsCode": "// Builds the Telegram message for one exception-occurred event (docs/backend/automation.md).\n// The message is sent with parse mode HTML, where only &, < and > are markup in inserted text.\nconst maxMessageLength = 1000;\nconst maxStackTraceLength = 2500; // Telegram refuses a message over 4096 characters\nconst timeFormat = \"yyyy-MM-dd HH:mm:ss 'GMT'ZZ\";\n\nconst escapeHtml = (text) =>\n  String(text ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;');\nconst truncate = (text, maxLength) =>\n  text.length > maxLength ? `${text.slice(0, maxLength - 1)}…` : text;\n\nreturn $input.all().map((item) => {\n  const event = item.json.body;\n  const data = event.data;\n  const time = DateTime.fromISO(event.occurredAt).setZone($env.GENERIC_TIMEZONE).toFormat(timeFormat);\n  const lines = [\n    `<b>${escapeHtml($env.WEBCITY_PRODUCT_NAME)}: unhandled exception</b>`,\n    `<b>Type:</b> <code>${escapeHtml(data.exceptionType)}</code>`,\n    `<b>Message:</b> ${escapeHtml(truncate(String(data.message ?? ''), maxMessageLength))}`,\n    `<b>Where:</b> <code>${escapeHtml(data.place)}</code> (${escapeHtml(data.placeKind)})`,\n    `<b>When:</b> ${escapeHtml(time)}`,\n  ];\n  const stackTrace = String(data.stackTrace ?? '');\n  const hasStackTrace = stackTrace.length > 0;\n  if (hasStackTrace) {\n    lines.push('', `<pre>${escapeHtml(truncate(stackTrace, maxStackTraceLength))}</pre>`);\n  }\n  return { json: { text: lines.join('\\n') } };\n});\n"
      },
      "id": "5f0c3a52-8a4e-4c1b-9d2f-0e6b1a7c4d06",
