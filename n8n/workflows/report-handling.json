      "id": "5f0c3a52-8a4e-4c1b-9d2f-0e6b1a7c4f06",
      "name": "Settings: hide after N reports",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        -100
      ],
      "notes": "A post or comment with reportsToHide or more pending reports within the last windowHours is hidden.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Builds the messages for one report-created event (docs/backend/automation.md) and decides whether to hide.\n// Telegram messages use parse mode HTML (&, < and > are markup there, and &quot; is understood); the email is HTML too.\n// The count and the window come from the settings node before this one: change them there, not here.\nconst maxExcerptLength = 500; // four excerpts and the fixed lines stay under Telegram's 4096-character limit\nconst timeFormat = \"yyyy-MM-dd HH:mm 'GMT'ZZ\";\n\nconst escapeHtml = (text) =>\n  String(text ?? '')\n    .replaceAll('&', '&amp;')\n    .replaceAll('<', '&lt;')\n    .replaceAll('>', '&gt;')\n    .replaceAll('\"', '&quot;');\nconst truncate = (text, maxLength) =>\n  text.length > maxLength ? `${text.slice(0, maxLength - 1)}…` : text;\nconst excerpt = (text) => escapeHtml(truncate(String(text ?? ''), maxExcerptLength));\nconst byAuthor = (author) => ` by ${escapeHtml(author?.username)}`;\n\n// One entry per target type: the moderation route (none for a user, who is never hidden), the snapshot, and its lines.\nconst targetTypes = {\n  Post: {\n    route: 'posts',\n    snapshotOf: (data) => data.post,\n    describe: (post) => ({\n      suffix: byAuthor(post.author),\n      details: [`<b>Title:</b> ${excerpt(post.title)}`, `<b>Text:</b> ${excerpt(post.postContent)}`],\n    }),\n  },\n  Comment: {\n    route: 'comments',\n    snapshotOf: (data) => data.comment,\n    describe: (comment) => ({\n      suffix: byAuthor(comment.author),\n      details: [\n        `<b>On post:</b> #${comment.postId} ${excerpt(comment.postTitle)}`,\n        `<b>Text:</b> ${excerpt(comment.content)}`,\n      ],\n    }),\n  },\n  User: {\n    route: null,\n    snapshotOf: (data) => data.user,\n    describe: (user) => ({\n      suffix: ` ${escapeHtml(user.username)}`,\n      details: user.bio ? [`<b>Bio:</b> ${excerpt(user.bio)}`] : [],\n    }),\n  },\n};\n\n// What was reported, as lines of HTML: the first names the target, the rest come from its snapshot when there is one.\nconst describeTarget = (data, targetType) => {\n  const snapshot = targetType.snapshotOf(data);\n  const { suffix, details } = snapshot ? targetType.describe(snapshot) : { suffix: '', details: [] };\n  return [`<b>Reported:</b> ${data.targetType.toLowerCase()} #${data.targetId}${suffix}`, ...details];\n};\n\nreturn $input.all().map((item) => {\n  const { reportsToHide, windowHours } = item.json;\n  const event = item.json.body;\n  const data = event.data;\n  const targetType = targetTypes[data.targetType];\n  const product = escapeHtml($env.WEBCITY_PRODUCT_NAME);\n  const reportsUrl = escapeHtml(`${$env.WEBCITY_FRONTEND_URL}/admin/reports`);\n  const reportedAt = DateTime.fromISO(event.occurredAt);\n  const windowStart = reportedAt.minus({ hours: windowHours });\n  const pendingTimes = data.pendingReportTimes ?? [];\n  const recentCount = pendingTimes.filter((time) => DateTime.fromISO(time) > windowStart).length;\n\n  const isContent = targetType.route !== null;\n  const isAlreadyHidden = Boolean(targetType.snapshotOf(data)?.isHidden);\n  const shouldHide = isContent && !isAlreadyHidden && recentCount >= reportsToHide;\n\n  const targetLines = describeTarget(data, targetType);\n  const alertText = [\n    `<b>${product}: new report</b>`,\n    ...targetLines,\n    `<b>Reason:</b> ${excerpt(data.reason)}`,\n    `<b>Reporter:</b> ${escapeHtml(data.reporterUsername)} (#${data.reporterId})`,\n    `<b>When:</b> ${escapeHtml(reportedAt.setZone($env.GENERIC_TIMEZONE).toFormat(timeFormat))}`,\n    `<b>Pending reports:</b> ${pendingTimes.length}, ${recentCount} in the last ${windowHours} hours`,\n  ].join('\\n');\n\n  const hiddenTitle = `${data.targetType.toLowerCase()} #${data.targetId} hidden by reports`;\n  const hiddenSummary = `It reached ${recentCount} pending reports within ${windowHours} hours (the limit is ${reportsToHide}). The reports are still pending: decide them in the reports list.`;\n  const hiddenText = [\n    `<b>${product}: ${escapeHtml(hiddenTitle)}</b>`,\n    ...targetLines,\n    `<b>Last reason:</b> ${excerpt(data.reason)}`,\n    escapeHtml(hiddenSummary),\n    `<a href=\"${reportsUrl}\">Open the reports list</a>`,\n  ].join('\\n');\n  const hiddenHtml = [\n    '<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5; color: #222;\">',\n    `<h2>${product}: ${escapeHtml(hiddenTitle)}</h2>`,\n    ...targetLines.map((line) => `<p>${line}</p>`),\n    `<p><b>Last reason:</b> ${excerpt(data.reason)}</p>`,\n    `<p>${escapeHtml(hiddenSummary)}</p>`,\n    `<p><a href=\"${reportsUrl}\">Open the reports list</a></p>`,\n    '</div>',\n  ].join('\\n');\n\n  return {\n    json: {\n      alertText,\n      shouldHide,\n      targetRoute: targetType.route ?? '',\n      targetId: data.targetId,\n      hiddenText,\n      hiddenSubject: `${$env.WEBCITY_PRODUCT_NAME}: ${hiddenTitle}`,\n      hiddenHtml,\n    },\n  };\n});\n"
      },
