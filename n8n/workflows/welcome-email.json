    {
      "parameters": {
        "jsCode": "// Builds the welcome email for one account-created event (docs/backend/automation.md).\n// The text and the layout live here: change them in n8n and export the workflow, no backend change needed.\nconst escapeHtml = (text) =>\n  String(text ?? '')\n    .replaceAll('&', '&amp;')\n    .replaceAll('<', '&lt;')\n    .replaceAll('>', '&gt;')\n    .replaceAll('\"', '&quot;');\n\nconst productName = escapeHtml($env.WEBCITY_PRODUCT_NAME);\nconst frontendUrl = escapeHtml($env.WEBCITY_FRONTEND_URL);\n\nreturn $input.all().map((item) => {\n  const data = item.json.body.data;\n  const username = escapeHtml(data.username);\n  const html = [\n    '<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5; color: #222;\">',\n    `<h2>Welcome to ${productName}, ${username}!</h2>`,\n    `<p>${productName} is a place to show what you make to friends and to people who share your hobby: post your work, comment on others, make friends and chat with them.</p>`,\n    `<p><a href=\"${frontendUrl}\">Open ${productName}</a> and make your first post.</p>`,\n    '</div>',\n  ].join('\\n');\n  return {\n    json: {\n      to: data.email,\n      subject: `Welcome to ${$env.WEBCITY_PRODUCT_NAME}`,\n      html,\n    },\n  };\n});\n"
      },
      "id": "5f0c3a52-8a4e-4c1b-9d2f-0e6b1a7c4e06",
