    {
      "parameters": {
        "jsCode": "// Turns each downloaded photo into a base64 data URL, the form OpenAI's moderation endpoint takes.\n// A photo that answers 404 was deleted after the event (with its post, or alone): its check is dropped, and if the post\n// is gone too, the moderation call answers 404 later. Any other answer fails the run, so a photo is never skipped unseen.\nconst photoFound = 200;\nconst photoGone = 404;\nconst checks = [];\n\nfor (const [index, item] of $input.all().entries()) {\n  const { check, photoAddress } = $('List the checks').itemMatching(index).json;\n  const status = item.json.statusCode;\n  const isFound = status === photoFound;\n  const isGone = status === photoGone;\n\n  if (isFound) {\n    const buffer = await this.helpers.getBinaryDataBuffer(index, 'data');\n    const url = `data:${item.binary.data.mimeType};base64,${buffer.toString('base64')}`;\n    checks.push({ json: { check, input: [{ type: 'image_url', image_url: { url } }] } });\n  } else if (!isGone) {\n    throw new Error(`Downloading ${photoAddress} answered ${status}`);\n  }\n}\n\nreturn checks;\n"
      },
      "id": "6a1d4b63-9c5e-4d2f-8e3a-1b7c2d4e5f14",
      "name": "Make the data URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -200
      ]
    },
    {
      "parameters": {},
