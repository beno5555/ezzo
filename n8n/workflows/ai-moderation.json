    {
      "parameters": {
        "jsCode": "// Reads one content event (docs/backend/automation.md) and lists what OpenAI checks.\n// The text (a post's title and text) is one check. Each photo of a new post is a check of its own: OpenAI refuses\n// more than one image in a call. An edit cannot add photos, so an edit is checked on its text alone.\n// Direct messages never reach this workflow: the backend sends no event for them.\nreturn $input.all().flatMap((item) => {\n  const event = item.json.body;\n  const data = event.data;\n  const isPost = event.event.startsWith('post-');\n  const isNewPost = event.event === 'post-created';\n  const text = isPost ? `${data.title}\\n\\n${data.text}` : data.text;\n  const photoAddresses = isNewPost ? (data.photoAddresses ?? []) : [];\n\n  return [\n    { json: { check: 'text', input: text } },\n    ...photoAddresses.map((photoAddress, index) => ({ json: { check: `photo ${index + 1}`, photoAddress } })),\n  ];\n});\n"
      },
      "id": "6a1d4b63-9c5e-4d2f-8e3a-1b7c2d4e5f11",
      "name": "List the checks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "6a1d4b63-9c5e-4d2f-8e3a-1b7c2d4e5f62",
              "leftValue": "={{ $json.photoAddress }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6a1d4b63-9c5e-4d2f-8e3a-1b7c2d4e5f12",
      "name": "Photo?",
