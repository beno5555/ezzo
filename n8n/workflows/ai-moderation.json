    {
      "parameters": {
        "jsCode": "// Decides one event from OpenAI's answers, one per check, and writes the alert.\n// The highest result across the checks decides: any category score at or above hideScore hides; otherwise any check\n// that OpenAI marks as violating flags. The score comes from the settings node before this one: change it there.\n// Telegram messages use parse mode HTML (&, < and > are markup there, and &quot; is understood); the email is HTML too.\nconst maxExcerptLength = 1500; // the title, the text and the fixed lines stay under Telegram's 4096-character limit\nconst { hideScore, body: event } = $('Settings: hide score').first().json;\nconst data = event.data;\nconst checks = $('All checks').all();\n\nconst escapeHtml = (text) =>\n  String(text ?? '')\n    .replaceAll('&', '&amp;')\n    .replaceAll('<', '&lt;')\n    .replaceAll('>', '&gt;')\n    .replaceAll('\"', '&quot;');\nconst truncate = (text, maxLength) =>\n  text.length > maxLength ? `${text.slice(0, maxLength - 1)}…` : text;\nconst excerpt = (text) => escapeHtml(truncate(String(text ?? ''), maxExcerptLength));\n\n// One entry per event: what the content is, the moderation route, its id, and the lines that describe it.\nconst contentTypes = {\n  'post-created': { name: 'post', action: 'new post', route: 'posts', id: data.postId, postId: data.postId },\n  'post-edited': { name: 'post', action: 'edited post', route: 'posts', id: data.postId, postId: data.postId },\n  'comment-created': { name: 'comment', action: 'new comment', route: 'comments', id: data.commentId, postId: data.postId },\n  'comment-edited': { name: 'comment', action: 'edited comment', route: 'comments', id: data.commentId, postId: data.postId },\n};\nconst content = contentTypes[event.event];\nconst isPost = content.route === 'posts';\n\n// The highest score of each category across the checks, with the check it came from, and whether any check flagged it.\nconst highest = {};\n$input.all().forEach((item, index) => {\n  const result = item.json.results[0];\n  for (const [category, score] of Object.entries(result.category_scores)) {\n    const known = highest[category];\n    const isHigher = !known || score > known.score;\n    if (isHigher) {\n      highest[category] = { score, check: checks[index].json.check, flagged: known?.flagged ?? false };\n    }\n    highest[category].flagged ||= Boolean(result.categories[category]);\n  }\n});\n\nconst categories = Object.entries(highest);\nconst hidingCategories = categories.filter(([, found]) => found.score >= hideScore);\nconst flaggingCategories = categories.filter(([, found]) => found.flagged);\nconst isHidden = hidingCategories.length > 0;\nconst isFlagged = flaggingCategories.length > 0;\nconst outcome = isHidden ? 'Hidden' : isFlagged ? 'Flagged' : 'None';\n// Content that already has the outcome (a Flagged post edited and flagged again) is left alone: the route would change\n// nothing, and the administrators were alerted the first time.\nconst isChange = outcome !== 'None' && outcome !== data.moderationStatus;\n\n// One entry per outcome: the categories that decided it, and where the alert's link leads.\nconst outcomes = {\n  Hidden: { categories: hidingCategories, linkUrl: `${$env.WEBCITY_FRONTEND_URL}/posts/${content.postId}`, linkText: 'Open the post' },\n  Flagged: { categories: flaggingCategories, linkUrl: `${$env.WEBCITY_FRONTEND_URL}/admin/moderation`, linkText: 'Open the moderation queue' },\n  None: { categories: [], linkUrl: '', linkText: '' },\n};\nconst { categories: decidingCategories, linkUrl, linkText } = outcomes[outcome];\nconst categoryList = [...decidingCategories]\n  .sort(([, a], [, b]) => b.score - a.score)\n  .map(([category, found]) => `${category} ${found.score.toFixed(3)} (${found.check})`)\n  .join(', ');\n\nconst product = escapeHtml($env.WEBCITY_PRODUCT_NAME);\nconst title = `${content.name} #${content.id} ${outcome.toLowerCase()} by AI moderation`;\nconst checkedPhotoCount = checks.filter((check) => check.json.check !== 'text').length;\nconst contentLines = [\n  `<b>What:</b> ${escapeHtml(content.action)}${isPost ? '' : ` on post #${data.postId}`}`,\n  `<b>Author:</b> ${escapeHtml(data.authorUsername)} (#${data.authorId})`,\n  ...(isPost ? [`<b>Title:</b> ${excerpt(data.title)}`] : []),\n  `<b>Text:</b> ${excerpt(data.text)}`,\n  ...(checkedPhotoCount > 0 ? [`<b>Photos checked:</b> ${checkedPhotoCount}`] : []),\n  `<b>Outcome:</b> ${outcome}`,\n  `<b>Categories:</b> ${escapeHtml(categoryList)}`,\n];\nconst alertText = [\n  `<b>${product}: ${escapeHtml(title)}</b>`,\n  ...contentLines,\n  `<a href=\"${escapeHtml(linkUrl)}\">${linkText}</a>`,\n].join('\\n');\nconst alertHtml = [\n  '<div style=\"font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5; color: #222;\">',\n  `<h2>${product}: ${escapeHtml(title)}</h2>`,\n  ...contentLines.map((line) => `<p style=\"white-space: pre-wrap;\">${line}</p>`),\n  `<p><a href=\"${escapeHtml(linkUrl)}\">${linkText}</a></p>`,\n  '</div>',\n].join('\\n');\n\nreturn [\n  {\n    json: {\n      outcome,\n      isChange,\n      route: content.route,\n      id: content.id,\n      alertText,\n      alertSubject: `${$env.WEBCITY_PRODUCT_NAME}: ${title}`,\n      alertHtml,\n    },\n  },\n];\n"
      },
