{
  "name": "webcity",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && tsc -p tools/tsconfig.json && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test eslint-rules/*.test.js tools/screenshots/*.test.ts",
    "screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tools/screenshots/screenshots.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-georgian": "^5.3.0",
    "@lucide/angular": "^1.73.0",
    "@microsoft/signalr": "^10.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^30.0.0",
    "playwright": "1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  }
}
