Table "Roles" {
  "Id" int [not null, increment]
  "Name" nvarchar(100) [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Roles"]
  }
}

Table "Users" {
  "Id" int [not null, increment]
  "Username" nvarchar(100) [not null]
  "Email" nvarchar(100) [not null]
  "DateOfBirth" datetime2 [not null]
  "PasswordHash" nchar(44) [not null]
  "PasswordSalt" nchar(44) [not null]
  "UsernameLastChangedAt" datetime2(3)
  "LastOnlineAt" datetime2(3)
  "Bio" nvarchar(300)
  "DigestEmailEnabled" bit [not null, default: `CAST(1 AS bit)`]
  "ResetTokenHash" nvarchar(44)
  "ResetTokenExpiresAt" datetime2
  "AccountDeactivatedAt" datetime2
  "AccountDeletedAt" datetime2
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Checks {
    `DATEDIFF(year, DateOfBirth, GETUTCDATE()) BETWEEN 13 AND 100` [name: 'CK_User_DateOfBirth']
  }

  Indexes {
    Id [pk, name: "PK_Users"]
    Email [unique, name: "IX_Users_Email"]
    Username [unique, name: "IX_Users_Username"]
  }
}

Table "Friendships" {
  "Id" int [not null, increment]
  "FriendshipStatus" nvarchar(30) [not null]
  "SentAt" datetime2 [not null, default: `GETUTCDATE()`]
  "RequesterUserId" int [not null]
  "AddresseeUserId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Friendships"]
    AddresseeUserId [name: "IX_Friendships_AddresseeUserId"]
    (RequesterUserId, AddresseeUserId) [unique, name: "IX_Friendships_RequesterUserId_AddresseeUserId"]
  }
}

Table "Logs" {
  "Id" int [not null, increment]
  "AuthorizedRequest" bit [not null, default: `CAST(0 AS bit)`]
  "UserId" int
  "Succeeded" bit [not null, default: `CAST(1 AS bit)`]
  "Action" nvarchar(100) [not null]
  "Details" nvarchar(1000)
  "EntityName" nvarchar(50)
  "EntityId" int
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Logs"]
    UserId [name: "IX_Logs_UserId"]
  }
}

Table "Messages" {
  "Id" int [not null, increment]
  "MessageContent" nvarchar(1000) [not null]
  "SeenAt" datetime2(3)
  "Seen" bit [not null]
  "SenderUserId" int [not null]
  "ReceiverUserId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Messages"]
    ReceiverUserId [name: "IX_Messages_ReceiverUserId"]
    (SenderUserId, ReceiverUserId, CreatedAt) [name: "IX_Messages_SenderUserId_ReceiverUserId_CreatedAt"]
  }
}

Table "Posts" {
  "Id" int [not null, increment]
  "PostTitle" nvarchar(100) [not null]
  "PostContent" nvarchar(3000) [not null]
  "ModerationStatus" nvarchar(30) [not null, default: `N'Visible'`]
  "UserId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Posts"]
    UserId [name: "IX_Posts_UserId"]
  }
}

Table "RefreshTokens" {
  "Id" int [not null, increment]
  "UserId" int [not null]
  "TokenHash" nvarchar(44) [not null]
  "ExpiresAt" datetime2 [not null]
  "RevokedAt" datetime2
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3) [default: `GETUTCDATE()`]

  Indexes {
    Id [pk, name: "PK_RefreshTokens"]
    TokenHash [unique, name: "IX_RefreshTokens_TokenHash"]
    UserId [name: "IX_RefreshTokens_UserId"]
  }
}

Table "Reports" {
  "Id" int [not null, increment]
  "TargetType" nvarchar(30) [not null]
  "TargetId" int [not null]
  "Reason" nvarchar(500) [not null]
  "Status" nvarchar(30) [not null]
  "ReporterUserId" int [not null]
  "ReviewedByUserId" int
  "ReviewedAt" datetime2(3)
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Reports"]
    (ReporterUserId, TargetType, TargetId) [unique, name: "IX_Reports_ReporterUserId_TargetType_TargetId"]
    ReviewedByUserId [name: "IX_Reports_ReviewedByUserId"]
    (Status, CreatedAt) [name: "IX_Reports_Status_CreatedAt"]
  }
}

Table "UserRoles" {
  "UserId" int [not null]
  "RoleId" int [not null]

  Indexes {
    (UserId, RoleId) [pk, name: "PK_UserRoles"]
    RoleId [name: "IX_UserRoles_RoleId"]
  }
}

Table "MessageImages" {
  "Id" int [not null, increment]
  "MessageId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)
  "Address" nvarchar(200) [not null]
  "OrderIndex" int [not null]

  Indexes {
    Id [pk, name: "PK_MessageImages"]
    MessageId [name: "IX_MessageImages_MessageId"]
  }
}

Table "Comments" {
  "Id" int [not null, increment]
  "CommentContent" nvarchar(500) [not null]
  "ModerationStatus" nvarchar(30) [not null, default: `N'Visible'`]
  "CommenterUserId" int
  "PostId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_Comments"]
    CommenterUserId [name: "IX_Comments_CommenterUserId"]
    PostId [name: "IX_Comments_PostId"]
  }
}

Table "PostImages" {
  "Id" int [not null, increment]
  "PostId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)
  "Address" nvarchar(200) [not null]
  "OrderIndex" int [not null]

  Indexes {
    Id [pk, name: "PK_PostImages"]
    PostId [name: "IX_PostImages_PostId"]
  }
}

Table "PostLikes" {
  "Id" int [not null, increment]
  "PostId" int [not null]
  "UserId" int [not null]
  "CreatedAt" datetime2(3) [not null]
  "LastUpdatedAt" datetime2(3)

  Indexes {
    Id [pk, name: "PK_PostLikes"]
    (PostId, UserId) [unique, name: "IX_PostLikes_PostId_UserId"]
    UserId [name: "IX_PostLikes_UserId"]
  }
}

Ref "FK_Friendships_Users_AddresseeUserId":"Users"."Id" < "Friendships"."AddresseeUserId"

Ref "FK_Friendships_Users_RequesterUserId":"Users"."Id" < "Friendships"."RequesterUserId"

Ref "FK_Logs_Users_UserId":"Users"."Id" < "Logs"."UserId" [delete: set null]

Ref "FK_Messages_Users_ReceiverUserId":"Users"."Id" < "Messages"."ReceiverUserId"

Ref "FK_Messages_Users_SenderUserId":"Users"."Id" < "Messages"."SenderUserId"

Ref "FK_Posts_Users_UserId":"Users"."Id" < "Posts"."UserId"

Ref "FK_RefreshTokens_Users_UserId":"Users"."Id" < "RefreshTokens"."UserId" [delete: cascade]

Ref "FK_Reports_Users_ReporterUserId":"Users"."Id" < "Reports"."ReporterUserId"

Ref "FK_Reports_Users_ReviewedByUserId":"Users"."Id" < "Reports"."ReviewedByUserId"

Ref "FK_UserRoles_Roles_RoleId":"Roles"."Id" < "UserRoles"."RoleId" [delete: cascade]

Ref "FK_UserRoles_Users_UserId":"Users"."Id" < "UserRoles"."UserId" [delete: cascade]

Ref "FK_MessageImages_Messages_MessageId":"Messages"."Id" < "MessageImages"."MessageId" [delete: cascade]

Ref "FK_Comments_Posts_PostId":"Posts"."Id" < "Comments"."PostId" [delete: cascade]

Ref "FK_Comments_Users_CommenterUserId":"Users"."Id" < "Comments"."CommenterUserId" [delete: set null]

Ref "FK_PostImages_Posts_PostId":"Posts"."Id" < "PostImages"."PostId" [delete: cascade]

Ref "FK_PostLikes_Posts_PostId":"Posts"."Id" < "PostLikes"."PostId" [delete: cascade]

Ref "FK_PostLikes_Users_UserId":"Users"."Id" < "PostLikes"."UserId"

